---
---
<section class="hero" id="inicio" aria-label="Bienvenida">

  <!-- Imagen de fondo -->
  <div class="hero-bg" aria-hidden="true"></div>

  <!-- Overlay degradado para integrar la imagen con el diseño oscuro -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- Partículas de brasa (coherentes con las velas de la imagen) -->
  <div class="hero-particles" aria-hidden="true">
    <span></span><span></span><span></span>
    <span></span><span></span><span></span>
    <span></span><span></span>
  </div>

  <!-- Contenido principal -->
  <div class="hero-content">
    <div class="hero-badge">Diócesis de Orihuela · Alicante</div>
    <h1 class="hero-name">Kairós</h1>
    <p class="hero-grace">Momento de Gracia</p>
    <p class="hero-tagline">
      <strong>Adoración</strong> &nbsp;·&nbsp;
      <strong>Reconciliación</strong> &nbsp;·&nbsp;
      <strong>Encuentro</strong>
    </p>
    <blockquote class="hero-mission">
      <p>"Nuestra vocación: la música, la pintura, la Adoración.<br>
      Nuestra misión: ponerla al servicio de Dios."</p>
    </blockquote>
    <div class="hero-actions">
      <a href="#conciertos" class="btn-flame">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 6l4-4 4 4M12 2v13M20 21H4"/></svg>
        Próximos conciertos
      </a>
      <a href="#adoracion" class="btn-ghost">Conoce el grupo</a>
    </div>
    <div class="hero-qr-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
      Estás en la iglesia. Bienvenido al momento de gracia.
    </div>
  </div>

  <a href="#adoracion" class="hero-scroll" aria-label="Desplazarse hacia abajo">
    <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </a>
</section>

<style>
/* ── Sección ── */
.hero {
  min-height: 100svh;
  display: flex; align-items: center; justify-content: center;
  text-align: center; padding: 9rem 2rem 7rem;
  position: relative; overflow: hidden;
  background: #080603;
}

/* ── Imagen de fondo ── */
.hero-bg {
  position: absolute; inset: 0;
  background-image: url('/hero-bg.jpg');
  background-size: cover;
  background-position: center 40%;
  background-repeat: no-repeat;
  /* La imagen es horizontal: centramos en la zona de las manos/farol */
  transform: scale(1.03);   /* micro-zoom para ocultar bordes en zoom CSS */
  animation: hero-slow-zoom 20s ease-in-out infinite alternate;
}
@keyframes hero-slow-zoom {
  from { transform: scale(1.03); }
  to   { transform: scale(1.08); }
}

/* ── Overlay multicapa para integrar con el design system ── */
.hero-overlay {
  position: absolute; inset: 0; pointer-events: none;
  background:
    /* Capa principal: oscurece todo uniformemente para garantizar legibilidad */
    linear-gradient(180deg,
      rgba(6,4,2,0.72) 0%,
      rgba(6,4,2,0.55) 20%,
      rgba(6,4,2,0.60) 50%,
      rgba(6,4,2,0.65) 75%,
      rgba(6,4,2,0.92) 100%),
    /* Viñeta lateral → enmarca la imagen */
    radial-gradient(ellipse 70% 100% at 50% 50%,
      transparent 35%,
      rgba(6,4,2,0.5) 80%,
      rgba(6,4,2,0.8) 100%),
    /* Tinte cálido dorado sutil */
    radial-gradient(ellipse 60% 50% at 50% 50%,
      rgba(180,100,10,0.07) 0%,
      transparent 65%);
}

/* ── Partículas de brasa (van con la luz del farol) ── */
.hero-particles {
  position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 2;
}
.hero-particles span {
  position: absolute; border-radius: 50%; opacity: 0;
  width: var(--sz, 2px); height: var(--sz, 2px);
  background: var(--col, rgba(240,201,106,0.8));
  animation: ember-rise var(--dur, 9s) ease-in var(--delay, 0s) infinite;
}
.hero-particles span:nth-child(1) { left:42%; top:72%; --delay:0s;   --dur:9s;   --sz:2px;   --col:rgba(240,201,106,0.9); }
.hero-particles span:nth-child(2) { left:50%; top:68%; --delay:1.4s; --dur:8s;   --sz:2.5px; --col:rgba(232,136,42,0.8); }
.hero-particles span:nth-child(3) { left:58%; top:74%; --delay:2.8s; --dur:10s;  --sz:2px;   --col:rgba(255,200,80,0.7); }
.hero-particles span:nth-child(4) { left:46%; top:76%; --delay:0.7s; --dur:7.5s; --sz:1.5px; --col:rgba(240,160,40,0.8); }
.hero-particles span:nth-child(5) { left:54%; top:70%; --delay:3.5s; --dur:11s;  --sz:2px;   --col:rgba(255,220,100,0.6); }
.hero-particles span:nth-child(6) { left:44%; top:78%; --delay:1.9s; --dur:8.5s; --sz:1.5px; --col:rgba(232,136,42,0.7); }
.hero-particles span:nth-child(7) { left:56%; top:73%; --delay:4.2s; --dur:9.5s; --sz:2px;   --col:rgba(240,201,106,0.8); }
.hero-particles span:nth-child(8) { left:49%; top:80%; --delay:0.3s; --dur:7s;   --sz:3px;   --col:rgba(255,200,70,0.6); }

@keyframes ember-rise {
  0%   { opacity: 0; transform: translateY(0) translateX(0) scale(1); }
  15%  { opacity: 0.85; }
  70%  { opacity: 0.35; transform: translateY(-80px) translateX(10px) scale(0.7); }
  100% { opacity: 0;    transform: translateY(-130px) translateX(-5px) scale(0.3); }
}

/* ── Contenido ── */
.hero-content {
  position: relative; z-index: 3; max-width: 820px;
  /* Halo oscuro suave detrás de todo el bloque de texto */
  isolation: isolate;
}
.hero-content::before {
  content: '';
  position: absolute;
  inset: -3rem -4rem;
  background: radial-gradient(ellipse 80% 80% at 50% 50%,
    rgba(4,3,1,0.65) 0%,
    rgba(4,3,1,0.3)  55%,
    transparent      80%);
  border-radius: 50%;
  z-index: -1;
  pointer-events: none;
}

.hero-badge {
  display: inline-flex; align-items: center; gap: 0.6rem;
  font-size: 0.65rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase;
  color: rgba(212,168,71,0.8); border: 1px solid rgba(212,168,71,0.25);
  padding: 0.45rem 1.2rem; border-radius: 1px; margin-bottom: 2.5rem;
  animation: fade-in 1s ease both;
  backdrop-filter: blur(4px);
  background: rgba(6,4,2,0.25);
}
.hero-badge::before, .hero-badge::after { content: '✦'; font-size: 0.5rem; color: var(--gold); opacity: 0.7; }

.hero-name {
  font-family: var(--font-display);
  font-size: clamp(4.5rem, 12vw, 10rem); font-weight: 900;
  line-height: 0.9; letter-spacing: -0.02em;
  color: var(--flame); text-transform: uppercase;
  text-shadow:
    0 2px 4px  rgba(4,3,1,0.95),
    0 4px 12px rgba(4,3,1,0.9),
    0 0 40px   rgba(232,136,42,0.6),
    0 0 80px   rgba(212,168,71,0.25);
  margin-bottom: 0.5rem;
  animation: fade-up 1s ease 0.2s both;
}
.hero-grace {
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 4vw, 2.8rem); font-weight: 300; font-style: italic;
  color: var(--gold2); letter-spacing: 0.04em; margin-bottom: 2rem;
  text-shadow: 0 2px 8px rgba(4,3,1,0.9), 0 0 30px rgba(4,3,1,0.7);
  animation: fade-up 1s ease 0.35s both;
}
.hero-tagline {
  font-size: 0.72rem; letter-spacing: 0.3em; text-transform: uppercase;
  color: rgba(245,237,216,0.55); margin-bottom: 1.5rem;
  text-shadow: 0 1px 6px rgba(4,3,1,0.95);
  animation: fade-up 1s ease 0.5s both;
}
.hero-tagline strong { color: rgba(245,237,216,0.85); font-weight: 500; }
.hero-mission {
  font-family: var(--font-serif);
  font-size: 1.05rem; font-weight: 300; font-style: italic;
  color: rgba(245,237,216,0.65); max-width: 520px; margin: 0 auto 3rem;
  line-height: 1.8; border: none;
  text-shadow: 0 1px 6px rgba(4,3,1,0.9);
  animation: fade-up 1s ease 0.65s both;
}
.hero-actions {
  display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;
  margin-bottom: 2.5rem;
  animation: fade-up 1s ease 0.8s both;
}
.btn-flame {
  display: inline-flex; align-items: center; gap: 0.5rem;
  font-size: 0.72rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--deep); background: var(--flame);
  padding: 1rem 2.5rem; border-radius: 2px; text-decoration: none;
  transition: background 0.2s, transform 0.2s;
}
.btn-flame:hover { background: var(--gold2); transform: translateY(-1px); }
.btn-ghost {
  display: inline-flex; align-items: center; gap: 0.5rem;
  font-size: 0.72rem; font-weight: 400; letter-spacing: 0.15em; text-transform: uppercase;
  color: rgba(212,168,71,0.8); border: 1px solid rgba(212,168,71,0.3);
  padding: 1rem 2.5rem; border-radius: 2px; text-decoration: none;
  backdrop-filter: blur(4px); background: rgba(6,4,2,0.2);
  transition: all 0.2s;
}
.btn-ghost:hover { border-color: var(--gold); color: var(--gold); transform: translateY(-1px); }

.hero-qr-note {
  display: inline-flex; align-items: center; gap: 0.5rem;
  font-family: var(--font-serif); font-size: 0.82rem; font-style: italic;
  color: rgba(240,201,106,0.55);
  animation: fade-up 1s ease 1s both;
}
.hero-qr-note svg { stroke: var(--flame); opacity: 0.7; flex-shrink: 0; }

/* Scroll indicator */
.hero-scroll {
  position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
  animation: scrollbounce 2.2s ease-in-out infinite;
  opacity: 0.4; text-decoration: none; z-index: 3;
}
.hero-scroll svg { width: 22px; height: 22px; stroke: var(--gold); fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }

/* ── Keyframes ── */
@keyframes scrollbounce {
  0%,100% { transform: translateX(-50%) translateY(0); }
  50%      { transform: translateX(-50%) translateY(7px); }
}
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes fade-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }

/* ── Responsive ── */
@media (max-width: 600px) {
  .hero { padding: 7rem 1.25rem 6rem; }
  /* En móvil centramos más en el farol */
  .hero-bg { background-position: center 35%; }
}

@media (prefers-reduced-motion: reduce) {
  .hero-bg { animation: none !important; }
  .hero-particles span { animation: none !important; }
}
</style>
