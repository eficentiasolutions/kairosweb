---
// Imágenes de stock (Unsplash – libres de uso, licencia gratuita)
// Sustituir por fotos reales del grupo cuando estén disponibles
const photos = [
  {
    cls: 'wide tall',
    url: 'https://images.unsplash.com/photo-1519677100203-a0e668c92439?w=900&q=80&fit=crop',
    caption: 'Adoración eucarística',
    alt: 'Velas encendidas en interior de iglesia durante adoración',
  },
  {
    cls: '',
    url: 'https://images.unsplash.com/photo-1466442929976-97f336a657be?w=600&q=80&fit=crop',
    caption: 'Momento de gracia',
    alt: 'Interior de catedral con luz dorada',
  },
  {
    cls: '',
    url: 'https://images.unsplash.com/photo-1510915361894-db8b60106cb1?w=600&q=80&fit=crop',
    caption: 'En concierto',
    alt: 'Músico tocando guitarra en concierto de adoración',
  },
  {
    cls: 'wide',
    url: 'https://images.unsplash.com/photo-1548625361-58a9b86aa83b?w=900&q=80&fit=crop',
    caption: 'Iglesia · Comunidad · Encuentro',
    alt: 'Comunidad reunida en celebración litúrgica',
  },
];
---
<section id="galeria" class="section-galeria" aria-labelledby="galeria-title">
  <div class="container">

    <div class="reveal">
      <div class="s-label">Galería</div>
      <h2 class="s-title" id="galeria-title">Momentos <em>vividos</em></h2>
      <p class="gallery-intro">
        Iglesias, celebraciones, adoraciones y conciertos.
        Cada imagen es un momento de gracia compartido.
      </p>
    </div>

    <div class="gallery-grid reveal delay-1" role="list" aria-label="Galería de imágenes">
      {photos.map(photo => (
        <figure class={`g-item ${photo.cls}`} role="listitem">
          <img
            src={photo.url}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption class="g-caption">
            <span>{photo.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="gallery-footer reveal">
      <p>Síguenos en Instagram para ver más · <strong>@kairosmomentodegracia</strong></p>
      <a href="https://www.instagram.com/kairosmomentodegracia/"
         target="_blank" rel="noopener noreferrer"
         aria-label="Ir al perfil de Instagram de Kairós Momento de Gracia">
        Ver en Instagram
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
.section-galeria {
  padding: 7rem 2rem;
  background: var(--deep2);
  border-bottom: 1px solid var(--bg-gold);
}
.container { max-width: 1120px; margin: 0 auto; }

.s-label {
  font-size: 0.63rem; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase;
  color: var(--flame); margin-bottom: 0.9rem;
  display: flex; align-items: center; gap: 0.7rem;
}
.s-label::after { content: ''; display: block; width: 32px; height: 1px; background: var(--flame); opacity: 0.4; }
.s-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 700; line-height: 1.1;
  color: var(--cream); margin-bottom: 1rem;
}
.s-title em { font-style: italic; color: var(--gold2); font-weight: 400; }
.gallery-intro {
  font-size: 0.9rem; color: var(--muted); margin-bottom: 2.5rem;
  max-width: 480px; line-height: 1.7;
}

/* ── Grid de fotos ── */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: 280px 200px;
  gap: 6px;
}

.g-item {
  position: relative; overflow: hidden;
  border-radius: 3px; margin: 0;
  border: 1px solid rgba(212,168,71,0.08);
  background: var(--deep3);
  transition: border-color 0.3s;
}
.g-item:hover { border-color: rgba(212,168,71,0.3); }
.g-item.wide { grid-column: span 2; }
.g-item.tall { grid-row: span 2; }

.g-item img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease, filter 0.4s ease;
  filter: brightness(0.82) saturate(0.85);
}
/* Tinte dorado sutil via overlay de color mix */
.g-item::before {
  content: '';
  position: absolute; inset: 0; z-index: 1;
  background: rgba(20,10,2,0.25);
  transition: background 0.4s;
  pointer-events: none;
}
.g-item:hover img {
  transform: scale(1.05);
  filter: brightness(0.92) saturate(1);
}
.g-item:hover::before { background: rgba(20,10,2,0.1); }

/* Caption sobre la foto */
.g-caption {
  position: absolute; bottom: 0; left: 0; right: 0; z-index: 2;
  padding: 2.5rem 1.2rem 1rem;
  background: linear-gradient(to top, rgba(8,5,2,0.85) 0%, transparent 100%);
  font-family: var(--font-serif);
  font-size: 0.78rem; font-weight: 300; font-style: italic;
  letter-spacing: 0.06em; color: rgba(212,168,71,0.5);
  transform: translateY(4px);
  transition: color 0.3s, transform 0.3s;
}
.g-item:hover .g-caption {
  color: rgba(212,168,71,0.85);
  transform: translateY(0);
}

/* Footer de la galería */
.gallery-footer {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 1.8rem; flex-wrap: wrap; gap: 1rem;
}
.gallery-footer p { font-size: 0.82rem; color: var(--muted); }
.gallery-footer strong { color: var(--gold2); }
.gallery-footer a {
  display: inline-flex; align-items: center; gap: 0.5rem;
  font-size: 0.72rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--gold2); text-decoration: none; transition: gap 0.2s;
}
.gallery-footer a:hover { gap: 0.9rem; }
.gallery-footer a svg {
  width: 14px; height: 14px; stroke: currentColor;
  fill: none; stroke-width: 2; stroke-linecap: round;
}

/* Reveal */
.reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
.reveal.visible { opacity: 1; transform: translateY(0); }
.delay-1 { transition-delay: 0.1s; }

/* Responsive */
@media (max-width: 900px) {
  .section-galeria { padding: 4.5rem 1.5rem; }
  .gallery-grid {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
  }
  .g-item.wide, .g-item.tall { grid-column: auto; grid-row: auto; }
  .g-item { height: 200px; }
}
@media (max-width: 480px) {
  .gallery-grid { grid-template-columns: 1fr; }
  .g-item { height: 220px; }
}
</style>
