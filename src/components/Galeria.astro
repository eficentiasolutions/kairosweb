---
const items = [
  { cls: 'g1 wide tall', symbol: 'candles', caption: 'Adoración eucarística' },
  { cls: 'g2',           symbol: 'cross',   caption: 'Custodia' },
  { cls: 'g3',           symbol: 'music',   caption: 'En concierto' },
  { cls: 'g4 wide',      symbol: 'church',  caption: 'Basílica Santa María · Elche' },
];
---
<section id="galeria" class="section-galeria" aria-labelledby="galeria-title">
  <div class="container">
    <div class="reveal">
      <div class="s-label">Galería</div>
      <h2 class="s-title" id="galeria-title">Momentos <em>vividos</em></h2>
      <p class="gallery-intro">Iglesias, celebraciones, adoraciones y conciertos. Cada imagen es un momento de gracia compartido. Próximamente fotos reales del grupo.</p>
    </div>

    <div class="gallery-grid reveal delay-1" role="list" aria-label="Galería de imágenes">
      {items.map(item => (
        <div class={`g-item ${item.cls}`} role="listitem" aria-label={item.caption}>
          <div class="g-inner">
            {item.symbol === 'candles' && (
              <svg class="g-symbol" viewBox="0 0 48 80" fill="none" aria-hidden="true">
                <ellipse cx="24" cy="12" rx="5" ry="8" fill="rgba(240,201,106,0.5)"/>
                <ellipse cx="24" cy="16" rx="3" ry="5" fill="rgba(232,136,42,0.7)"/>
                <rect x="20" y="20" width="8" height="48" rx="4" fill="rgba(245,237,216,0.15)"/>
                <ellipse cx="10" cy="18" rx="3" ry="6" fill="rgba(240,201,106,0.35)"/>
                <rect x="7" y="24" width="6" height="36" rx="3" fill="rgba(245,237,216,0.1)"/>
                <ellipse cx="38" cy="18" rx="3" ry="6" fill="rgba(240,201,106,0.35)"/>
                <rect x="35" y="24" width="6" height="36" rx="3" fill="rgba(245,237,216,0.1)"/>
              </svg>
            )}
            {item.symbol === 'cross' && (
              <svg class="g-symbol" viewBox="0 0 60 80" fill="none" aria-hidden="true">
                <rect x="26" y="4" width="8" height="72" rx="4" fill="rgba(212,168,71,0.4)"/>
                <rect x="4" y="24" width="52" height="8" rx="4" fill="rgba(212,168,71,0.4)"/>
                <circle cx="30" cy="28" r="10" fill="rgba(240,201,106,0.15)" stroke="rgba(212,168,71,0.4)" stroke-width="1.5"/>
                <circle cx="30" cy="28" r="4" fill="rgba(240,201,106,0.3)"/>
              </svg>
            )}
            {item.symbol === 'music' && (
              <svg class="g-symbol" viewBox="0 0 60 70" fill="none" aria-hidden="true">
                <path d="M22 52 L22 18 L46 12 L46 46" stroke="rgba(212,168,71,0.5)" stroke-width="3" stroke-linecap="round"/>
                <path d="M22 18 L46 12" stroke="rgba(212,168,71,0.4)" stroke-width="2"/>
                <ellipse cx="18" cy="54" rx="8" ry="5" transform="rotate(-15 18 54)" fill="rgba(232,136,42,0.35)"/>
                <ellipse cx="42" cy="48" rx="8" ry="5" transform="rotate(-15 42 48)" fill="rgba(232,136,42,0.35)"/>
              </svg>
            )}
            {item.symbol === 'church' && (
              <svg class="g-symbol" viewBox="0 0 80 70" fill="none" aria-hidden="true">
                <rect x="6" y="30" width="68" height="40" rx="2" fill="rgba(212,168,71,0.12)" stroke="rgba(212,168,71,0.3)" stroke-width="1"/>
                <polygon points="40,4 70,30 10,30" fill="rgba(212,168,71,0.18)" stroke="rgba(212,168,71,0.35)" stroke-width="1"/>
                <rect x="36" y="10" width="8" height="18" fill="rgba(240,201,106,0.3)"/>
                <rect x="38" y="4" width="4" height="14" fill="rgba(240,201,106,0.4)"/>
                <rect x="16" y="38" width="10" height="14" rx="5" fill="rgba(240,201,106,0.15)" stroke="rgba(212,168,71,0.25)" stroke-width="1"/>
                <rect x="54" y="38" width="10" height="14" rx="5" fill="rgba(240,201,106,0.15)" stroke="rgba(212,168,71,0.25)" stroke-width="1"/>
                <rect x="32" y="46" width="16" height="24" rx="8" fill="rgba(212,168,71,0.1)" stroke="rgba(212,168,71,0.25)" stroke-width="1"/>
              </svg>
            )}
            <div class="g-line" aria-hidden="true"></div>
            <p class="g-caption">{item.caption}</p>
          </div>
          <div class="g-add" aria-hidden="true">Añadir foto</div>
        </div>
      ))}
    </div>

    <div class="gallery-footer reveal">
      <p>Ver todas las fotos y vídeos en Instagram · <strong>@kairosmomentodegracia</strong></p>
      <a href="https://www.instagram.com/kairosmomentodegracia/" target="_blank" rel="noopener noreferrer" aria-label="Ir al perfil de Instagram de Kairós">
        Ir a Instagram
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
.section-galeria {
  padding: 7rem 2rem;
  background: var(--deep2);
  border-bottom: 1px solid var(--bg-gold);
}
.container { max-width: 1120px; margin: 0 auto; }

.s-label {
  font-size: 0.63rem; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase;
  color: var(--flame); margin-bottom: 0.9rem;
  display: flex; align-items: center; gap: 0.7rem;
}
.s-label::after { content: ''; display: block; width: 32px; height: 1px; background: var(--flame); opacity: 0.4; }
.s-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 700; line-height: 1.1;
  color: var(--cream); margin-bottom: 1.5rem;
}
.s-title em { font-style: italic; color: var(--gold2); font-weight: 400; }

.gallery-intro {
  font-size: 0.9rem; color: var(--muted); margin-bottom: 2.5rem;
  max-width: 480px; line-height: 1.7;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: 260px 180px;
  gap: 8px;
}
.g-item {
  overflow: hidden; border-radius: 3px;
  position: relative; border: 1px solid rgba(212,168,71,0.1);
  transition: border-color 0.3s;
  cursor: default;
}
.g-item:hover { border-color: rgba(212,168,71,0.35); }
.g-item.wide { grid-column: span 2; }
.g-item.tall { grid-row: span 2; }

.g-item.g1 {
  background:
    radial-gradient(ellipse 40% 30% at 50% 80%, rgba(232,136,42,0.3) 0%, transparent 60%),
    radial-gradient(ellipse 20% 20% at 30% 90%, rgba(212,168,71,0.2) 0%, transparent 50%),
    radial-gradient(ellipse 20% 20% at 70% 90%, rgba(212,168,71,0.2) 0%, transparent 50%),
    linear-gradient(180deg, #0d0a06 0%, #1c1508 50%, #0f0b05 100%);
}
.g-item.g2 {
  background:
    radial-gradient(ellipse 60% 60% at 50% 40%, rgba(240,201,106,0.2) 0%, transparent 65%),
    radial-gradient(ellipse 30% 30% at 50% 55%, rgba(212,168,71,0.35) 0%, transparent 50%),
    linear-gradient(160deg, #0e0c08 0%, #1e1810 60%, #120f08 100%);
}
.g-item.g3 {
  background:
    radial-gradient(ellipse 50% 70% at 50% 30%, rgba(232,136,42,0.18) 0%, transparent 60%),
    radial-gradient(ellipse 80% 40% at 50% 100%, rgba(180,90,10,0.25) 0%, transparent 55%),
    linear-gradient(180deg, #12100c 0%, #1a1510 60%, #0e0b07 100%);
}
.g-item.g4 {
  background:
    radial-gradient(ellipse 70% 50% at 50% 60%, rgba(212,168,71,0.15) 0%, transparent 65%),
    radial-gradient(ellipse 40% 30% at 20% 80%, rgba(232,136,42,0.12) 0%, transparent 50%),
    radial-gradient(ellipse 40% 30% at 80% 80%, rgba(232,136,42,0.12) 0%, transparent 50%),
    linear-gradient(180deg, #0c0a06 0%, #181410 50%, #100d08 100%);
}

.g-inner {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 1rem;
}
.g-symbol {
  width: 60px; height: 80px; opacity: 0.18;
  transition: opacity 0.3s;
  filter: sepia(1) saturate(3) hue-rotate(10deg);
}
.g-item:hover .g-symbol { opacity: 0.38; }
.g-caption {
  font-family: var(--font-serif);
  font-size: 0.78rem; font-weight: 300; font-style: italic; letter-spacing: 0.08em;
  color: rgba(212,168,71,0.3); transition: color 0.3s;
  text-align: center; padding: 0 1.5rem;
}
.g-item:hover .g-caption { color: rgba(212,168,71,0.65); }
.g-line {
  width: 0; height: 1px; background: var(--gold);
  opacity: 0.4; transition: width 0.4s ease;
}
.g-item:hover .g-line { width: 40px; }
.g-add {
  position: absolute; bottom: 0.8rem; right: 0.9rem;
  font-size: 0.58rem; letter-spacing: 0.15em; text-transform: uppercase;
  color: rgba(212,168,71,0.2); border: 1px dashed rgba(212,168,71,0.15);
  padding: 0.2rem 0.6rem; border-radius: 2px;
}

.gallery-footer {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 2rem; flex-wrap: wrap; gap: 1rem;
}
.gallery-footer p { font-size: 0.82rem; color: var(--muted); }
.gallery-footer strong { color: var(--gold2); }
.gallery-footer a {
  display: inline-flex; align-items: center; gap: 0.5rem;
  font-size: 0.72rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--gold2); text-decoration: none; transition: gap 0.2s;
}
.gallery-footer a:hover { gap: 0.9rem; }
.gallery-footer a svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; }

/* Reveal */
.reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
.reveal.visible { opacity: 1; transform: translateY(0); }
.delay-1 { transition-delay: 0.1s; }

@media (max-width: 900px) {
  .section-galeria { padding: 4.5rem 1.5rem; }
  .gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
  .g-item.wide, .g-item.tall { grid-column: auto; grid-row: auto; }
  .g-item { height: 180px; }
}
</style>
