---
---
<section id="contacto" class="section-contacto" aria-labelledby="contacto-title">
  <div class="container">
    <div class="reveal">
      <div class="s-label">Contacto</div>
      <h2 class="s-title" id="contacto-title">¿Quieres que actuemos en tu <em>comunidad</em>?</h2>
    </div>

    <div class="contact-grid">
      <!-- Columna izquierda: info -->
      <div class="contact-left reveal">
        <p class="intro">Si tu parroquia, comunidad o encuentro quiere contar con nosotros, escríbenos. Estamos disponibles en toda la Diócesis de Orihuela-Alicante y más allá.</p>

        <div class="c-links">
          <a href="https://www.instagram.com/kairosmomentodegracia/" target="_blank" rel="noopener noreferrer" class="c-link">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            <div class="c-link-wrap">
              <span class="c-link-label">Instagram</span>
              <span>@kairosmomentodegracia</span>
            </div>
          </a>
          <a href="mailto:kairosmomentodegracia@gmail.com" class="c-link">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <div class="c-link-wrap">
              <span class="c-link-label">Email</span>
              <span>kairosmomentodegracia@gmail.com</span>
            </div>
          </a>
          <a href="https://www.diocesisoa.org" target="_blank" rel="noopener noreferrer" class="c-link">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <div class="c-link-wrap">
              <span class="c-link-label">Diócesis</span>
              <span>Orihuela-Alicante · Vicaría de Evangelización</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Columna derecha: formulario -->
      <div class="form-col reveal delay-1">
        <form
          class="contact-form"
          name="contacto-kairos"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          id="kairos-form"
          novalidate
          aria-label="Formulario de contacto"
        >
          <input type="hidden" name="form-name" value="contacto-kairos" />
          <div class="honeypot" aria-hidden="true">
            <label>No rellenar: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="form-row">
            <div class="field-wrap">
              <label for="nombre">Nombre <span class="req" aria-hidden="true">*</span></label>
              <input id="nombre" type="text" name="nombre" placeholder="Tu nombre" required autocomplete="name" />
              <span class="field-error" id="error-nombre">Este campo es obligatorio</span>
            </div>
            <div class="field-wrap">
              <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
              <input id="email" type="email" name="email" placeholder="tu@email.com" required autocomplete="email" />
              <span class="field-error" id="error-email">Introduce un email válido</span>
            </div>
          </div>

          <div class="field-wrap">
            <label for="parroquia">Parroquia o comunidad</label>
            <input id="parroquia" type="text" name="parroquia" placeholder="Nombre de tu parroquia o comunidad" autocomplete="organization" />
          </div>

          <div class="field-wrap">
            <label for="evento">Tipo de evento</label>
            <div class="select-wrap">
              <select id="evento" name="evento">
                <option value="" disabled selected>Selecciona el tipo de evento</option>
                <option value="adoracion">Adoración eucarística</option>
                <option value="concierto">Concierto de música cristiana</option>
                <option value="parroquial">Celebración parroquial</option>
                <option value="juvenil">Encuentro juvenil</option>
                <option value="retiro">Retiro espiritual</option>
                <option value="otro">Otro</option>
              </select>
              <svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>

          <div class="field-wrap">
            <label for="mensaje">Mensaje <span class="req" aria-hidden="true">*</span></label>
            <textarea
              id="mensaje" name="mensaje"
              placeholder="Cuéntanos sobre tu evento, fechas posibles, lugar…"
              required rows="5"
            ></textarea>
            <span class="field-error" id="error-mensaje">Este campo es obligatorio</span>
          </div>

          <div class="form-actions">
            <p class="form-privacy">Al enviar aceptas que usemos tu email para responderte.</p>
            <button type="submit" class="btn-submit" id="btn-submit">
              <span class="btn-text">Enviar solicitud</span>
              <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
          </div>
        </form>

        <!-- Mensaje de éxito — completamente fuera del flujo hasta que se necesite -->
        <div class="form-success" id="form-success" aria-live="polite" aria-atomic="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <p>¡Mensaje enviado! Os contestaremos lo antes posible. Dios os bendiga.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.section-contacto {
  padding: 7rem 2rem;
  background: var(--deep);
  border-bottom: 1px solid var(--bg-gold);
}
.container { max-width: 1120px; margin: 0 auto; }

.s-label {
  font-size: 0.63rem; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase;
  color: var(--flame); margin-bottom: 0.9rem;
  display: flex; align-items: center; gap: 0.7rem;
}
.s-label::after { content: ''; display: block; width: 32px; height: 1px; background: var(--flame); opacity: 0.4; }

.s-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 700; line-height: 1.1;
  color: var(--cream); margin-bottom: 1.5rem;
}
.s-title em { font-style: italic; color: var(--gold2); font-weight: 400; }

/* Grid */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 5rem;
  margin-top: 3rem;
  align-items: start;
}

/* Columna izquierda */
.contact-left p.intro {
  font-family: var(--font-serif); font-size: 1.05rem; font-style: italic; font-weight: 300;
  color: rgba(245,237,216,0.5); line-height: 1.8; margin-bottom: 2rem;
}
.c-links { display: flex; flex-direction: column; gap: 0.75rem; }
.c-link {
  display: flex; align-items: center; gap: 1rem; padding: 0.95rem 1.3rem;
  border: 1px solid rgba(255,255,255,0.06); border-radius: 3px;
  background: rgba(255,255,255,0.02); text-decoration: none;
  color: rgba(245,237,216,0.55); font-size: 0.88rem; transition: all 0.2s;
}
.c-link:hover { color: var(--gold2); border-color: var(--bg-gold); background: rgba(212,168,71,0.04); }
.c-link svg {
  width: 18px; height: 18px; stroke: var(--flame); fill: none;
  stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0;
}
.c-link-wrap { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
.c-link-label {
  font-size: 0.65rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--flame);
}

/* Columna derecha */
.form-col { display: flex; flex-direction: column; gap: 0; }

/* Honeypot */
.honeypot { display: none; }

/* Formulario */
.contact-form {
  display: flex; flex-direction: column; gap: 1rem;
}

.form-row {
  display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
}

.field-wrap {
  display: flex; flex-direction: column; gap: 0.4rem;
  position: relative;
}
.field-wrap label {
  font-size: 0.68rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
  color: rgba(245,237,216,0.35);
}
.req { color: var(--flame); margin-left: 2px; }

.contact-form input,
.contact-form select,
.contact-form textarea {
  width: 100%;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 3px;
  padding: 0.85rem 1.1rem;
  font-family: var(--font-body); font-size: 0.88rem;
  color: rgba(245,237,216,0.85);
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  line-height: 1.5;
}
.contact-form input::placeholder,
.contact-form textarea::placeholder { color: rgba(245,237,216,0.2); }
.contact-form input:focus,
.contact-form select:focus,
.contact-form textarea:focus {
  border-color: rgba(232,136,42,0.5);
  box-shadow: 0 0 0 3px rgba(232,136,42,0.08);
}
.contact-form input.is-error,
.contact-form select.is-error,
.contact-form textarea.is-error {
  border-color: #c45a5a;
}
.contact-form textarea {
  resize: vertical;
  min-height: 130px;
}

/* Select personalizado */
.select-wrap {
  position: relative;
}
.select-wrap select {
  appearance: none; -webkit-appearance: none;
  cursor: pointer;
  padding-right: 2.5rem;
}
.select-wrap select option { background: var(--deep2); color: var(--cream); }
.select-arrow {
  position: absolute; right: 0.9rem; top: 50%; transform: translateY(-50%);
  width: 16px; height: 16px;
  stroke: rgba(212,168,71,0.45); pointer-events: none;
}

/* Mensajes de error por campo */
.field-error {
  font-size: 0.72rem; color: #e07070;
  display: none;
}
.field-wrap.has-error .field-error { display: block; }
.field-wrap.has-error input,
.field-wrap.has-error textarea { border-color: #c45a5a; }

/* Acciones del form */
.form-actions {
  display: flex; align-items: center; justify-content: space-between;
  gap: 1rem; flex-wrap: wrap;
  margin-top: 0.25rem;
}
.form-privacy {
  font-size: 0.72rem; color: rgba(245,237,216,0.2);
  flex: 1; min-width: 0;
}
.btn-submit {
  display: inline-flex; align-items: center; gap: 0.55rem; flex-shrink: 0;
  font-family: var(--font-body); font-size: 0.72rem; font-weight: 500;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--deep); background: var(--flame); border: none; border-radius: 2px;
  padding: 0.9rem 2rem; cursor: pointer;
  transition: background 0.2s, transform 0.2s, opacity 0.2s;
}
.btn-submit:hover { background: var(--gold2); transform: translateY(-1px); }
.btn-submit:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }

/* Mensaje de éxito — oculto por defecto */
.form-success {
  display: none;                         /* oculto hasta que JS lo active */
  align-items: flex-start; gap: 1rem;
  padding: 1.2rem 1.5rem;
  border-radius: 3px;
  background: rgba(50,110,60,0.18);
  border: 1px solid rgba(80,160,90,0.35);
  color: #8de0a0;
  margin-top: 1rem;
}
.form-success.visible {
  display: flex;
}
.form-success p {
  font-size: 0.9rem; line-height: 1.6;
  color: #8de0a0;
}
.form-success svg { stroke: #8de0a0; flex-shrink: 0; margin-top: 2px; }

/* Reveal */
.reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
.reveal.visible { opacity: 1; transform: translateY(0); }
.delay-1 { transition-delay: 0.12s; }

@media (max-width: 900px) {
  .section-contacto { padding: 4.5rem 1.5rem; }
  .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
  .form-row { grid-template-columns: 1fr; }
  .form-actions { flex-direction: column; align-items: stretch; }
  .btn-submit { justify-content: center; }
}
</style>

<script>
const form = document.getElementById('kairos-form') as HTMLFormElement | null;
const successEl = document.getElementById('form-success')!;
const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;

if (!form) throw new Error('Form not found');

// Valida un campo individual
function validateField(input: HTMLInputElement | HTMLTextAreaElement): boolean {
  const wrap = input.closest('.field-wrap') as HTMLElement | null;
  if (!wrap) return true;
  let ok = true;
  if (input.hasAttribute('required') && !input.value.trim()) {
    ok = false;
  } else if (input.type === 'email' && input.value.trim()) {
    ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim());
  }
  wrap.classList.toggle('has-error', !ok);
  return ok;
}

// Quitar error al escribir
form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach(el => {
  el.addEventListener('input', () => {
    const wrap = el.closest('.field-wrap') as HTMLElement | null;
    wrap?.classList.remove('has-error');
  });
});

form.addEventListener('submit', async (e) => {
  e.preventDefault();

  // Validar todos los campos requeridos
  const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([name="bot-field"]), textarea'));
  const allValid = fields.map(validateField).every(Boolean);
  if (!allValid) {
    // Enfocar el primer campo con error
    const firstError = form.querySelector<HTMLElement>('.has-error input, .has-error textarea');
    firstError?.focus();
    return;
  }

  // Enviar
  submitBtn.disabled = true;
  const btnText = submitBtn.querySelector('.btn-text')!;
  btnText.textContent = 'Enviando…';

  try {
    const data = new FormData(form);
    const body = new URLSearchParams();
    data.forEach((value, key) => body.append(key, value as string));

    const res = await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body.toString(),
    });

    if (res.ok) {
      form.reset();
      form.style.display = 'none';
      successEl.classList.add('visible');
    } else {
      throw new Error('server error');
    }
  } catch {
    // Fallback: mailto
    const nombre = (form.querySelector<HTMLInputElement>('[name="nombre"]')?.value ?? '').trim();
    const emailVal = (form.querySelector<HTMLInputElement>('[name="email"]')?.value ?? '').trim();
    const mensajeVal = (form.querySelector<HTMLTextAreaElement>('[name="mensaje"]')?.value ?? '').trim();
    window.location.href =
      `mailto:kairosmomentodegracia@gmail.com` +
      `?subject=${encodeURIComponent('Solicitud de actuación - ' + nombre)}` +
      `&body=${encodeURIComponent(mensajeVal + '\n\nContacto: ' + emailVal)}`;
    btnText.textContent = 'Enviar solicitud';
    submitBtn.disabled = false;
  }
});
</script>
