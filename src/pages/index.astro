---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Adoracion from '../components/Adoracion.astro';
import Conciertos from '../components/Conciertos.astro';
import Galeria from '../components/Galeria.astro';
import Vocacion from '../components/Vocacion.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
---
<Layout>
  <Nav />
  <main id="main">
    <Hero />
    <Adoracion />
    <Conciertos />
    <Galeria />
    <Vocacion />
    <Contacto />
  </main>
  <Footer />
  <ScrollReveal />
</Layout>
